__pycache__/
*.py[cod]
*.sqlite3
# SQLite's write-ahead log and shared-memory companions (run data)
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
.env
.venv/
.pytest_cache/
.coverage
dist/
build/
*.egg-info/

.mypy_cache/
.ruff_cache/
validation-results/
bench-results/

# Local harness state (hook audit log, artifacts, installed plugins) stays ignored;
# the live config files the root models.toml uses are tracked (Phase 17).
.agent-harness/*
!.agent-harness/agents/
!.agent-harness/hooks/
!.agent-harness/skills/
!.agent-harness/templates/
!.agent-harness/tools/
!.agent-harness/sandbox_tools/
!.agent-harness/instructions/
# Installed plugins stay local, except the one the root models.toml enables.
!.agent-harness/plugins/
.agent-harness/plugins/*
!.agent-harness/plugins/security-review/
.DS_Store
.gstack/
# Benchmark baselines are per machine and per model (scripts/validate.sh --update-baselines)
baselines/
# Local env variants and backups (secrets); the template stays tracked
.env.*
!.env.example
# Public benchmark datasets (scripts/fetch_datasets.sh)
datasets/
