# Only needed by profiles that specify api_key_env = "HOSTED_MODEL_API_KEY".
HOSTED_MODEL_API_KEY=replace-me

# Copy to .env (gitignored). agent-harness, agent-harness-bench, and scripts/validate.sh
# read ./.env at startup; variables already set in the shell win.

# One switch: this profile serves chat, embeddings, and the guard model.
# llamacpp | ollama | modal
AGENT_HARNESS_MODEL_PROFILE=llamacpp

# Only needed if you enable a LiteLLM profile for a hosted provider.
# ANTHROPIC_API_KEY=replace-me

# Modal-hosted vLLM/SGLang (profile "modal"). Both layers are required.
# Bearer key the inference server was started with (--api-key).
MODAL_LLM_API_KEY=replace-me
# Modal proxy auth token (create in the Modal dashboard: Settings > Proxy Auth Tokens).
MODAL_PROXY_TOKEN_ID=replace-me
MODAL_PROXY_TOKEN_SECRET=replace-me
# Real Modal endpoints stay here, never in models.toml (three deployments, one profile):
# AGENT_HARNESS_MODEL__MODAL__ENABLED=true
# AGENT_HARNESS_MODEL__MODAL__ENDPOINT=https://WORKSPACE--agent-harness-vllm-serve.modal.run/v1
# AGENT_HARNESS_MODEL__MODAL__EMBEDDING_ENDPOINT=https://WORKSPACE--agent-harness-vllm-embed-serve.modal.run/v1
# AGENT_HARNESS_MODEL__MODAL__GUARD_ENDPOINT=https://WORKSPACE--agent-harness-vllm-guard-serve.modal.run/v1
# Optional shared-L4 layout (deploy/modal/shared_l4/): embeddings and the guard in one app, so
# both endpoints name the same URL:
# AGENT_HARNESS_MODEL__MODAL__EMBEDDING_ENDPOINT=https://WORKSPACE--agent-harness-vllm-companions-serve.modal.run/v1
# AGENT_HARNESS_MODEL__MODAL__GUARD_ENDPOINT=https://WORKSPACE--agent-harness-vllm-companions-serve.modal.run/v1
# Lifecycle: deploy/modal/scripts/{deploy,start,stop,undeploy}.sh (embed, guard, H200 chat) and
# deploy/modal/shared_l4/{deploy,start,stop,undeploy}.sh (the shared app only).

# Modal Shared Endpoint (profile "modal_shared", per token): the proxy token in its combined form,
# ID and secret joined with "." (wk-<id>.ws-<secret>). It borrows the modal profile's embed and
# guard deployments, so keep that profile enabled too.
# MODAL_SHARED_TOKEN=wk-replace-me.ws-replace-me
# AGENT_HARNESS_MODEL__MODAL_SHARED__ENABLED=true
# AGENT_HARNESS_MODEL__MODAL_SHARED__ENDPOINT=https://WORKSPACE--ep-deepseek-v4-1-flash-server.us-west.modal.direct/v1
# AGENT_HARNESS_MODEL_PROFILE=modal_shared

# Built-in web search (models.toml [web_search]).
# TAVILY_API_KEY=replace-me

# HTTP API key for `agent-harness serve` (models.toml [[api.keys]] "me", admin). Use your
# own random value, at least 16 characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# The CLI does not need it. Clients send it as `Authorization: Bearer <key>`.
# AGENT_HARNESS_API_KEY=replace-me-with-a-long-random-value

# Webhook for run notifications (models.toml [notifications]); dormant while unset.
# AGENT_HARNESS_SET__NOTIFICATIONS__WEBHOOK_URL=https://ntfy.sh/your-topic
